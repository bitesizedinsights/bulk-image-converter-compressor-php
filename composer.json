{
    "name": "bitesizedinsights/bulk-image-converter-compressor",
    "description": "Bulk image converter and compressor for PHP: WebP, AVIF, JPEG, PNG and resizing via Apify, typed DTOs.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "image converter",
        "image compressor",
        "image resizer",
        "bulk image conversion",
        "webp",
        "avif",
        "heic",
        "image optimization",
        "php",
        "apify",
        "api client"
    ],
    "homepage": "https://github.com/bitesizedinsights/bulk-image-converter-compressor-php",
    "support": {
        "issues": "https://github.com/bitesizedinsights/bulk-image-converter-compressor-php/issues",
        "source": "https://github.com/bitesizedinsights/bulk-image-converter-compressor-php"
    },
    "authors": [
        {
            "name": "bite-sized-insights",
            "homepage": "https://apify.com/bite-sized-insights"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "pestphp/pest": "^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "ImageConverter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ImageConverter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "cs": "pint --test",
        "cs:fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": [
            "@cs",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
